{
  "name": "dsh-opencode-local",
  "displayName": "DSH OpenCode Local",
  "description": "把本机 OpenCode 客户端（opencode serve）的模型接入 DeepSeek Harness：复用官方客户端的本地回环服务访问免费模型，工具仍由 DSH 自己声明和执行。",
  "version": "0.3.3",
  "author": "yuchao (https://github.com/yuchaos0927)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuchaos0927/dsh-opencode-local.git"
  },
  "bugs": {
    "url": "https://github.com/yuchaos0927/dsh-opencode-local/issues"
  },
  "homepage": "https://github.com/yuchaos0927/dsh-opencode-local#readme",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "icon": "icon.svg",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "opencode",
    "free-models",
    "llm-adapter",
    "local"
  ],
  "scripts": {
    "test": "node --import ./test/loader.mjs --test test/startup.test.mjs && node --test test/local-service.test.mjs && node --import ./test/loader.mjs --test test/adapter.test.mjs && node --import ./test/loader.mjs --test test/stream.test.mjs",
    "pack:local": "npm pack --pack-destination dist"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "LICENSE",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.5 <5.0.0-0",
    "@deepseek-ai/dsh-llm": ">=0.2.1-rc.2 <0.2.2-0 || >=0.2.2-rc.0 <0.2.3-0 || >=0.2.3-rc.0 <0.2.4-0 || >=0.2.4-rc.0 <0.2.5-0 || >=0.2.5-rc.0 <0.2.6-0 || >=0.2.6-rc.0 <0.2.7-0 || >=0.2.7-rc.0 <0.2.8-0 || >=0.2.8-rc.0 <0.2.9-0 || >=0.2.9-rc.0 <0.3.0-0",
    "@deepseek-ai/schemastery": ">=3.18.2 <4.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "private": false
}
